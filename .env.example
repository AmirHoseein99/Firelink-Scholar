# Provider preset: "openrouter" (default) or "groq". Controls the default
# base URL when LLM_BASE_URL is unset.
LLM_PROVIDER=openrouter

# OpenAI-compatible LLM endpoint. Override for self-hosted providers (e.g. Ollama, vLLM).
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model identifier passed to /chat/completions. Required.
LLM_MODEL=

# API key for the LLM endpoint. Required.
LLM_API_KEY=

# HTTP proxy URL used for outbound requests. Empty string disables proxying.
LLM_PROXY=http://127.0.0.1:2080

# --- Groq (used when LLM_PROVIDER=groq; LLM_API_KEY/LLM_MODEL above also work) ---
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- NeuralWatt (LLM grading of eval candidate pools; see eval/llm_grade.py) ---
# OpenAI-compatible endpoint used by the eval grader. Fill in the API key
# before running: python -m eval.llm_grade
NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1
NEURALWATT_MODEL=glm-5.3-flash
NEURALWATT_API_KEY=